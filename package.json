{
  "name": "@isolated-vm/workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "clang-format": "find packages -name '*.cc' -exec clang-format -i {} \\;",
    "lint:cc": "run-clang-tidy -allow-no-checks -p build",
    "lint:js": "eslint --fix packages",
    "test": "pnpm run --recursive --sequential --silent test:${TEST_SCOPE:-node}"
  },
  "devDependencies": {
    "@auto_js/js": "workspace:^",
    "@eslint/js": "^9.39.5",
    "@isolated-vm/experimental": "workspace:^",
    "@napi-rs/cli": "^3.5.1",
    "@stylistic/eslint-plugin": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@auto_js/js": "workspace:^",
    "@changesets/cli": "^2.30.0",
    "tslib": "^2.7.0"
  }
}

# Downloads `URL` to `DOWNLOAD_CACHE_DIR`. This directory can be cached across builds.
function(download_cached VARIABLE_NAME URL)
	# Select `DOWNLOAD_CACHE_DIR`
	if(NOT DEFINED DOWNLOAD_CACHE_DIR AND DEFINED ENV{DOWNLOAD_CACHE_DIR})
		set(DOWNLOAD_CACHE_DIR "$ENV{DOWNLOAD_CACHE_DIR}")
		cmake_path(ABSOLUTE_PATH DOWNLOAD_CACHE_DIR BASE_DIRECTORY "${CMAKE_SOURCE_DIR}")
		set(DOWNLOAD_CACHE_DIR "${DOWNLOAD_CACHE_DIR}" CACHE PATH "Directory of downloaded files, kept across build directories")
	endif()
	if(DEFINED DOWNLOAD_CACHE_DIR)
		set(DIRECTORY "${DOWNLOAD_CACHE_DIR}")
	else()
		set(DIRECTORY "${CMAKE_BINARY_DIR}/_downloads")
	endif()
	# The file is the URL without its scheme, with `.` and `..` segments collapsed
	string(FIND "${URL}" "://" SCHEME_END)
	if(SCHEME_END EQUAL -1)
		message(FATAL_ERROR "Not a URL: '${URL}'")
	endif()
	math(EXPR PATH_START "${SCHEME_END} + 3")
	string(SUBSTRING "${URL}" ${PATH_START} -1 FILE)
	cmake_path(NORMAL_PATH FILE)
	cmake_path(APPEND DIRECTORY "${FILE}" OUTPUT_VARIABLE FILE)
	# Fetch
	if(NOT EXISTS "${FILE}")
		message(STATUS "Downloading '${URL}'")
		file(DOWNLOAD "${URL}" "${FILE}" STATUS STATUS)
		list(GET STATUS 0 RESULT)
		if(NOT RESULT EQUAL 0)
			file(REMOVE "${FILE}")
			list(GET STATUS 1 MESSAGE)
			message(FATAL_ERROR "Failed to download '${URL}': ${MESSAGE}")
		endif()
	endif()
	set(${VARIABLE_NAME} "${FILE}" PARENT_SCOPE)
endfunction()
